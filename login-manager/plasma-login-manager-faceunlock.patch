+            if (greeterState.faceState === GreeterState.FaceState.Scanning) {
+                greeterState.faceMessage = i18nd("plasma_login", "Couldn't recognize you");
+                greeterState.faceState = GreeterState.FaceState.Failed;
+            }
+        }
+
+        function onInformationMessage(message) {
+            if (message.startsWith("Attempting facial authentication")) {
+                greeterState.faceMessage = i18nd("plasma_login", "Looking for you…");
+                greeterState.faceState = GreeterState.FaceState.Scanning;
+            } else if (message.startsWith("Identified face as")) {
+                greeterState.faceMessage = i18nd("plasma_login", "Welcome, %1", displayNameFor(greeterState.lastLoggedInUser));
+                greeterState.faceState = GreeterState.FaceState.Recognized;
+            } else if (greeterState.faceState === GreeterState.FaceState.Scanning && greeterState.isFaceMessage(message)) {
+                if (message.includes("too dark")) {
+                    greeterState.faceMessage = i18nd("plasma_login", "It's too dark to see you");
+                } else if (message.includes("no face model")) {
+                    greeterState.faceMessage = i18nd("plasma_login", "Face unlock isn't set up");
+                } else {
+                    greeterState.faceMessage = i18nd("plasma_login", "Couldn't recognize you");
+                }
+                greeterState.faceState = GreeterState.FaceState.Failed;
+            }
         }
     }
 }
