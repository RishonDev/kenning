# Face models are root-only; the face unlock service reads them for everyone else.
secure_models() {
    if [[ -d /etc/faceunlock/models ]]; then
        chmod 700 /etc/faceunlock/models
        find /etc/faceunlock/models -type f -exec chmod 600 {} +
    fi
}

# pacman reloads systemd only after the whole transaction; the socket is needed now.
start_service() {
    systemctl daemon-reload 2>/dev/null || true
    systemctl start faceunlock.socket 2>/dev/null || true
}

post_install() {
    /usr/lib/plasma-faceunlock/pam-tidy tidy
    start_service
    echo "  Open System Settings > Face Unlock and press Set Up to start using face unlock."
}

post_upgrade() {
    /usr/lib/plasma-faceunlock/pam-tidy tidy
    secure_models
    # A running service keeps the old engine until it exits; start the new one.
    start_service
    systemctl try-restart faceunlock.service 2>/dev/null || true
}

pre_remove() {
    /usr/lib/plasma-faceunlock/pam-tidy remove
    systemctl stop faceunlock.socket faceunlock.service 2>/dev/null || true
}
