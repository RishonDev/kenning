root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[{*.patch,PKGBUILD,*.SRCINFO}]
trim_trailing_whitespace = false

[PKGBUILD]
indent_size = 2
