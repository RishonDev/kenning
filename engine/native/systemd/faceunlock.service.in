[Unit]
Description=Face unlock service
Requires=faceunlock.socket

[Service]
ExecStart=@FACEUNLOCK_BINARY@ daemon
# Reads the camera, the config and the face models; writes nothing.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateNetwork=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native
